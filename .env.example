# CodeForge Environment Variables
# Copy to .env and fill in values. .env is gitignored.

# ── Optional ─────────────────────────────────────────────────────────────────

# Anthropic API key — OPTIONAL, not required.
# The LLM backend for dream/ship uses a fallback chain:
#   1. `claude -p` headless (Claude Code CLI, no key, best quality)  ← primary
#   2. ANTHROPIC_API_KEY (direct Haiku API, per-token billing)        ← this var
#   3. rule-based passthrough (no LLM)                                ← last resort
# Set this only if you want the Haiku API fallback when `claude -p` is unavailable.
# Get yours at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# Override the .codeforge/ directory location (default: $CWD/.codeforge/)
# Useful for shared/global memory across projects
# CODEFORGE_DIR=/home/user/.codeforge/global

# Override the data directory for state.db (default: ~/.local/share/codeforge/)
# CODEFORGE_DATA_DIR=/home/user/.local/share/codeforge

# UI locale: 'en' or 'zh-TW'
# Default: resolved from the system locale (sys_locale), falling back to 'en'.
# CODEFORGE_LOCALE=zh-TW

# Statusline panel width in columns (default: 100)
# CODEFORGE_WIDTH=100

# Dump the statusline's stdin JSON to /tmp for debugging (set to any value)
# CODEFORGE_DEBUG=1

# Override the target settings.json for install/uninstall (default: ~/.claude/settings.json)
# CODEFORGE_CLAUDE_SETTINGS=/path/to/settings.json
