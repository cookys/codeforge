# Normalize line endings across platforms (Windows checkouts default to CRLF via core.autocrlf)
* text=auto
*.sh text eol=lf
*.js text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf
.githooks/* text eol=lf
.hippo/ops/* merge=union eol=lf
.hippo/relocations.jsonl merge=union eol=lf
.hippo/bodies/* eol=lf
.hippo/records/*.md merge=hippo eol=lf
