# Build artifacts
/target
**/*.rs.bk
*.pdb

# Environment / secrets
.env
.env.*
!.env.example

# Runtime data (created by codeforge init / dream / learn)
.codeforge/
# session-digest 落盤片段(A′):明文 dev signal,絕不 commit。consumer repo 即使
# 只 gitignore 自己的 .codeforge 子集,這條 ** 規則仍擋住 digests/。
**/.codeforge/digests/

# SQLite databases (defense in depth — also covered by .codeforge/)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Claude Code session-local state
.claude/session-start-sha
.claude/scripts/session-digest.log
.claude/settings.local.json
.claude/next-state.json
**/CLAUDE.local.md

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
