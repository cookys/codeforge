{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "_installed_by": "codeforge@0.0.2",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/scripts/session-digest.js",
            "timeout": 30000,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "_installed_by": "codeforge@0.0.2",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/scripts/check-dev-flow.js",
            "timeout": 5000,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|Bash"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "_installed_by": "codeforge@0.0.2",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/scripts/emit-session.js session_end",
            "timeout": 3000,
            "type": "command"
          },
          {
            "_installed_by": "codeforge@0.0.2",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/scripts/session-digest.js",
            "timeout": 30000,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "_installed_by": "codeforge@0.0.2",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/scripts/check-improvements.js",
            "timeout": 10000,
            "type": "command"
          },
          {
            "_installed_by": "codeforge@0.0.2",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/scripts/emit-session.js session_start",
            "timeout": 3000,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}
